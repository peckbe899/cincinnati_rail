+        z = mpc.sample(xy)
+        dz = np.zeros(len(xy))
+        for rg in REG:
+            m = shapely.contains_xy(rg['band'], xy[:, 0], xy[:, 1])
+            for i in np.where(m)[0]:
+                v = rg['dz'](*xy[i])
+                if abs(v) > abs(dz[i]):
+                    dz[i] = v
