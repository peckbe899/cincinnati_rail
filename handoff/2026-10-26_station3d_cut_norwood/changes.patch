+                run = [k, []]
+                runs.append(run)
+            run[1].append((q.x, q.y, z))
+        for k, seg in runs:
+            if len(seg) < 2:
+                continue
+            a = np.array([(x, y) for x, y, _ in seg])
+            if k:
+                items.append({'type': 'rail', 'n': nm, 'sys': sysk, 'col': SYS_COL.get(sysk, '1baf7a'), 'x': enc(a[:, 0] - E0, 10), 'y': enc(a[:, 1] - N0, 10),
