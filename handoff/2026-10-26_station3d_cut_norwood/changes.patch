+        for st in cuts:
+            m = shapely.contains_xy(st['geom'], xy[:, 0], xy[:, 1])
+            for i in np.where(m)[0]:
+                z[i] = min(z[i], st['z'](*xy[i]) - st['below'])
+        return z
+
+    items, notes = [], []
+    # ---- structures ----
+    for st in S:
+        out = []
+        for p in polys(st['geom']):
+            p = p.buffer(0)
+            for q in polys(p):
