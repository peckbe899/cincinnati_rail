+        m2 = cv2.boxFilter(g * g, -1, (tw, th), normalize=True, borderType=cv2.BORDER_REPLICATE)
+        sd = np.sqrt(np.maximum(m2 - m1 * m1, 0))[th // 2:th // 2 + r.shape[0], tw // 2:tw // 2 + r.shape[1]]
+        bad = sd < min_std
