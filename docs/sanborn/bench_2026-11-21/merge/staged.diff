+def sample(segs, step=1.0):
+    pts, dirs, idx = [], [], []
+    for k, (a, b) in enumerate(segs):
+        a = np.asarray(a, float); b = np.asarray(b, float); L = np.hypot(*(b - a))
+        if L < 1e-6: continue
