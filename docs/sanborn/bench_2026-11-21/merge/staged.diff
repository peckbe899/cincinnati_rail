+def _paper(q):
+    """quarter-size BGR -> paper mask (bool): the bright sheet against the dark scanner bed"""
+    v = cv2.GaussianBlur(cv2.cvtColor(q, cv2.COLOR_BGR2HSV)[:, :, 2], (0, 0), 2)
+    b = (v > 130).astype(np.uint8)
