+        pts.append(a + np.outer(t, b - a)); dirs.append(np.repeat(((b - a) / L)[None], m, 0)); idx.append(np.full(m, k))
+    if not pts: return np.zeros((0, 2)), np.zeros((0, 2)), np.zeros(0, int)
+    return np.vstack(pts), np.vstack(dirs), np.concatenate(idx)
