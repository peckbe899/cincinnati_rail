                "data": {
                  "description": "The numbers behind the flag, shaped by its kind."
                }
              },
              "required": [
                "kind",
                "sev",
                "c0",
                "c1",
                "rule",
                "data"
              ],
              "additionalProperties": false,
              "title": "Flag",
