            "description": "The other lines this station is one station with (its complex), by their names (Line 3, A trunk), once each in the complex's order: the sheet tags the station with them as the old page tagged its crossings."
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What was found, a stable slug (grade_over_limit)."
                },
                "sev": {
                  "type": "string",
