                    "info",
                    "warn",
                    "error"
                  ]
                },
                "c0": {
                  "type": "number",
                  "x-unit": "m",
                  "description": "Start chainage of the range."
                },
                "c1": {
                  "type": "number",
                  "x-unit": "m",
                  "description": "End chainage of the range (equal to c0 for a point)."
                },
                "rule": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
                  "description": "A rule id of rules/registry.yaml, e.g. geometry.method.per_stretch."
