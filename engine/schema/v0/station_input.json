              },
              "z_m": {
                "type": "number",
                "x-unit": "m",
                "description": "Rail level at the vertex, metres NAVD88."
              }
            },
            "required": [
              "c_m",
              "z_m"
            ],
            "additionalProperties": false,
            "description": "A point of vertical intersection set by Ben."
