                "type": "number",
                "x-unit": "m",
                "description": "Ground level, metres NAVD88."
              }
            }
          },
          "required": [
            "step_m",
            "z_m"
          ],
          "additionalProperties": false,
          "description": "Ground levels along the section on a regular grid from chainage 0."
        }
      },
      "required": [
        "contract",
        "section_id",
        "length_m",
        "chainage_basis",
        "scale",
        "step_m",
        "params",
        "stations",
        "pvi"
      ],
      "additionalProperties": false,
      "title": "SectionInput",
      "description": "Contract section_input/0: the input of vertical.rail@1."
    },
    "route": {
      "type": "string",
      "description": "The route key (Line_3)."
    },
    "system": {
      "type": "string",
      "description": "metro, tri, ..."
    },
    "path": {
      "type": "array",
      "items": {
        "type": "array",
