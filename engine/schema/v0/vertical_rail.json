{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cincinnati-rail.invalid/engine/schema/v0/vertical_rail.json",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "vertical_rail/0"
    },
    "engine_build": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of engine/src/** and engine/package.json."
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of the canonical JSON (RFC 8785) of the SectionInput."
    },
    "grid": {
      "type": "object",
      "properties": {
        "c0": {
          "type": "number",
          "const": 0,
          "x-unit": "m",
          "description": "The grid starts at chainage 0."
        },
        "step_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "x-unit": "m",
          "description": "Grid step."
        },
        "n": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "x-unit": "count",
          "description": "Number of grid points, the length of every array."
        }
      },
      "required": [
        "c0",
        "step_m",
        "n"
      ],
      "additionalProperties": false,
      "description": "The chainage grid of the arrays: point i is at c0 + i * step_m."
    },
    "rail_m": {
      "type": "array",
      "items": {
        "type": "number",
        "x-unit": "m",
        "description": "Rail level, metres NAVD88."
      }
    },
    "grade_permille": {
      "type": "array",
      "items": {
        "type": "number",
        "x-unit": "permille",
        "description": "Grade."
      }
    },
    "dv": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "c_m": {
            "type": "number",
            "x-unit": "m",
            "description": "Chainage."
          },
          "z_m": {
            "type": "number",
            "x-unit": "m",
            "description": "Rail level, metres NAVD88."
          },
          "kind": {
            "type": "string",
            "enum": [
              "ps",
              "pe",
              "pvi",
              "end"
            ],
            "description": "ps platform start, pe platform end, pvi a vertex, end a section end."
          }
        },
        "required": [
          "c_m",
          "z_m",
          "kind"
        ],
        "additionalProperties": false,
        "description": "A vertex of the design line, sorted by (c, kind rank, order)."
      }
    },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "c_m": {
            "type": "number",
            "x-unit": "m",
            "description": "Chainage of the curve's vertex."
          },
          "g_in": {
            "type": "number",
            "x-unit": "permille",
            "description": "Grade in."
          },
          "g_out": {
            "type": "number",
            "x-unit": "permille",
            "description": "Grade out."
          },
          "L_m": {
            "type": "number",
            "minimum": 0,
            "x-unit": "m",
            "description": "Curve length."
          }
        },
        "required": [
          "c_m",
          "g_in",
          "g_out",
          "L_m"
        ],
        "additionalProperties": false,
        "description": "A parabolic vertical curve."
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "What was found, a stable slug (grade_over_limit)."
          },
          "sev": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "error"
            ]
          },
          "c0": {
            "type": "number",
            "x-unit": "m",
            "description": "Start chainage of the range."
          },
          "c1": {
            "type": "number",
            "x-unit": "m",
            "description": "End chainage of the range (equal to c0 for a point)."
          },
          "rule": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
            "description": "A rule id of rules/registry.yaml, e.g. geometry.method.per_stretch."
          },
          "data": {
            "description": "The numbers behind the flag, shaped by its kind."
          }
        },
        "required": [
          "kind",
          "sev",
          "c0",
          "c1",
          "rule",
          "data"
        ],
        "additionalProperties": false,
        "title": "Flag",
        "description": "A finding over a chainage range, citing the rule that raised it."
      }
    }
  },
  "required": [
    "contract",
    "engine_build",
    "input_hash",
    "grid",
    "rail_m",
    "grade_permille",
    "dv",
    "curves",
    "flags"
  ],
  "additionalProperties": false,
  "title": "VerticalRail",
  "description": "Contract vertical_rail/0: the output of vertical.rail@1."
}
